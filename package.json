{
  "name": "sprachen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,mcp -c cyan,magenta \"next dev -p 4800\" \"node scripts/mcp-tunnel.mjs --optional\"",
    "dev:web": "next dev -p 4800",
    "build": "next build",
    "start": "concurrently -n web,mcp -c cyan,magenta \"next start -p 4800\" \"node scripts/mcp-tunnel.mjs --optional\"",
    "start:web": "next start -p 4800",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:restart": "docker compose restart",
    "mcp:tunnel": "node scripts/mcp-tunnel.mjs",
    "mcp:install-client": "bash scripts/install-tunnel-client.sh",
    "test": "vitest run",
    "test:watch": "vitest"
  },
