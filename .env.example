# Environment Variables
# Copy to .env for local development

# SQLite database file (path relative to prisma/)
DATABASE_URL="file:../data/sprachen.db"

# Mother tongue / vocabulary source language (set once at install, do not change later)
# Options: de | en | es | fr | pt | gsw
NEXT_PUBLIC_NATIVE_LANG=de

# Target languages to train (comma-separated). Omit or leave empty for all except native.
# Example — only English, Spanish, French:
# NEXT_PUBLIC_TARGET_LANGS=en,es,fr
NEXT_PUBLIC_TARGET_LANGS=

# OpenAI API Key (required for AI features)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Secure MCP Tunnel (ChatGPT Developer Mode → /mcp)
# Key: https://platform.openai.com/settings/organization/api-keys (Tunnels Read + Use)
CONTROL_PLANE_API_KEY=
TUNNEL_PROFILE=sprachen

# Node Environment
NODE_ENV=development
