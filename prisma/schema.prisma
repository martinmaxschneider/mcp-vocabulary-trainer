// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum DomainKind {
  THEME
  GRAMMAR
  SPECIAL
}

// App models
model Domain {
  id            String        @id @default(cuid())
  name          String        @unique
  kind          DomainKind    @default(THEME)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  domainEntries DomainEntry[]
}

enum EntryType {
  WORD
  PROVERB
}

enum WordCategory {
  VERB
  NOUN
  ADJECTIVE
  PROVERB
  ADVERB
  PREPOSITION
  CONJUNCTION
  PRONOUN
  OTHER
}

model Entry {
  id        String        @id @default(cuid())
  type      EntryType
  category  WordCategory?
  mainLang  String        @default("de")
  mainText  String
  note      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  translations        Translation[]
  progresses          UserProgress[]
  domains             DomainEntry[]
  worksheetQuestions  WorksheetQuestion[]
}

model DomainEntry {
  id        String   @id @default(cuid())
  entryId   String
  domainId  String
  entry     Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  domain    Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([entryId, domainId])
  @@index([entryId])
  @@index([domainId])
}

model Translation {
  id      String @id @default(cuid())
  entryId String
  entry   Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)

  lang      String
  regionTag String?

  text     String
  variants Json?

  example  String?
  ipa      String?
  audioUrl String?

  /// Irregular conjugation paradigm for this target language (per-lang flag)
  isIrregular Boolean @default(false)

  /// @deprecated Prefer ConjugationForm rows; kept for migration/compat
  conjugations Json?

  conjugationForms ConjugationForm[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entryId, lang, regionTag])
  @@index([lang, isIrregular])
}

model ConjugationForm {
  id            String      @id @default(cuid())
  translationId String
  translation   Translation @relation(fields: [translationId], references: [id], onDelete: Cascade)
  tenseKey      String
  personIndex   Int
  form          String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([translationId, tenseKey, personIndex])
  @@index([translationId, tenseKey])
}

enum CardType {
  VOCAB
  CONJUGATION
}

model UserProgress {
  id             String    @id @default(cuid())
  userId         String    @default("anonymous")
  entryId        String
  entry          Entry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  targetLang     String    @default("en")
  /// VOCAB = translation card; CONJUGATION = one tense of a verb
  cardType       CardType  @default(VOCAB)
  /// "vocab" | "conj:<tenseKey>"
  cardKey        String    @default("vocab")
  box            Int       @default(1)
  nextReviewAt   DateTime  @default(now())
  correctCount   Int       @default(0)
  wrongCount     Int       @default(0)
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  reviews ReviewLog[]

  @@unique([userId, entryId, targetLang, cardKey])
  @@index([userId, targetLang, box])
  @@index([userId, targetLang, nextReviewAt])
  @@index([userId, nextReviewAt])
  @@index([userId, targetLang, cardType, nextReviewAt])
}

model ReviewLog {
  id             String       @id @default(cuid())
  userProgressId String
  userProgress   UserProgress @relation(fields: [userProgressId], references: [id], onDelete: Cascade)
  targetLang     String
  userAnswer     String
  expected       String
  isCorrect      Boolean
  typo           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([userProgressId])
  @@index([createdAt])
}

/// Aussprache-Cheat-Sheet pro Sprachpaar (Muttersprache → Zielsprache)
model PronunciationGuide {
  id         String                    @id @default(cuid())
  nativeLang String
  targetLang String
  items      PronunciationGuideItem[]
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt

  @@unique([nativeLang, targetLang])
  @@index([nativeLang])
  @@index([targetLang])
}

model PronunciationGuideItem {
  id          String             @id @default(cuid())
  guideId     String
  guide       PronunciationGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)
  /// IPA/Laut der Zielsprache, z.B. "ɑ̃", "ʃ", "tʃ"
  symbol      String
  /// Kurz-Umschrift in der Muttersprache, z.B. "ong", "sch"
  approx      String?
  /// Erklärung in der Muttersprache
  explanation String
  /// optionales Beispielwort in der Zielsprache
  exampleWord String?
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([guideId, symbol])
  @@index([guideId, sortOrder])
}

enum GrammarBlockType {
  RULE
  EXAMPLES
  NOTE
}

/// Grammatik-Kapitel pro Zielsprache (Nachschlagewerk; Inhalt via MCP/Chat)
model GrammarTopic {
  id         String         @id @default(cuid())
  targetLang String
  /// z.B. basics, verbs, pronouns, word_order
  category   String
  slug       String
  title      String
  /// Einzeilige Kurzfassung für die Themenliste
  summary    String
  /// Suchbegriffe als JSON-Array, z.B. ["possessiv","mi","tu"]
  keywords           Json?
  sortOrder          Int                 @default(0)
  blocks             GrammarBlock[]
  worksheetQuestions WorksheetQuestion[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([targetLang, slug])
  @@index([targetLang, category, sortOrder])
  @@index([targetLang, sortOrder])
}

model GrammarBlock {
  id        String           @id @default(cuid())
  topicId   String
  topic     GrammarTopic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  type      GrammarBlockType
  title     String?
  /// Text für RULE / NOTE (Muttersprache)
  body      String?
  /// JSON-Array für EXAMPLES: [{ native, target, note? }]
  examples  Json?
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([topicId, sortOrder])
}

enum WorksheetStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum WorksheetQuestionType {
  MULTIPLE_CHOICE
  CLOZE
  FREE_TEXT
  ERROR_CORRECTION
  SENTENCE_REORDER
  MATCHING
  TRUE_FALSE
  CONJUGATION_GRID
}

/// Klausur-/Übungsblatt; Inhalt via MCP, Ausfüllen in der App
model Worksheet {
  id          String              @id @default(cuid())
  targetLang  String
  title       String
  description String?
  /// z.B. Teilungsartikel, Verneinung
  section     String
  /// Anzeige-Nenner (z.B. 20); sonst Summe der Fragenspunkte
  maxScore    Int?
  status      WorksheetStatus     @default(OPEN)
  startedAt   DateTime?
  completedAt DateTime?
  questions   WorksheetQuestion[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([targetLang, status])
  @@index([createdAt])
}

model WorksheetQuestion {
  id             String                @id @default(cuid())
  worksheetId    String
  worksheet      Worksheet             @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  sortOrder      Int                   @default(0)
  type           WorksheetQuestionType
  categoryLabel  String?
  prompt         String
  hint           String?
  points         Int                   @default(1)
  /// Typ-spezifisch: Optionen, Lückentext, Tokens, Paare, Raster …
  payload        Json
  /// Erwartete Lösung(en)
  accepted       Json
  explanation    String?
  grammarTopicId String?
  grammarTopic   GrammarTopic?         @relation(fields: [grammarTopicId], references: [id], onDelete: SetNull)
  entryId        String?
  entry          Entry?                @relation(fields: [entryId], references: [id], onDelete: SetNull)
  /// JSON-Array, z.B. ["partitive","negation"]
  tags           Json?
  answer         WorksheetAnswer?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([worksheetId, sortOrder])
  @@index([grammarTopicId])
  @@index([entryId])
}

model WorksheetAnswer {
  id                    String            @id @default(cuid())
  questionId            String            @unique
  question              WorksheetQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userAnswer            Json
  autoCorrect           Boolean
  isTypo                Boolean           @default(false)
  /// null = automatische Bewertung, true = manuell richtig, false = manuell falsch
  manualOverride        Boolean?
  checkedAt             DateTime          @default(now())
  overriddenAt          DateTime?

  @@index([questionId])
}

/// One row per calendar day (local YYYY-MM-DD) for streak / daily XP.
model DailyActivity {
  id           String   @id @default(cuid())
  userId       String   @default("anonymous")
  date         String
  xp           Int      @default(0)
  answersCount Int      @default(0)
  correctCount Int      @default(0)
  /// { [lang]: { xp, answers, correct } }
  byLang       Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model UnlockedAchievement {
  id         String   @id @default(cuid())
  userId     String   @default("anonymous")
  key        String
  unlockedAt DateTime @default(now())
  targetLang String?
  meta       Json?

  @@unique([userId, key])
  @@index([userId])
}

model GamificationSettings {
  id            String   @id @default(cuid())
  userId        String   @default("anonymous")
  dailyGoalXp   Int      @default(50)
  longestStreak Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId])
}

enum EmbeddingOwnerType {
  ENTRY
  SATZ
}

/// Brute-force similarity index (no FK — polymorphic for Entry now, Satz later).
model Embedding {
  id        String              @id @default(cuid())
  ownerType EmbeddingOwnerType
  ownerId   String
  model     String
  dims      Int
  vector    Json
  textHash  String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([ownerType, ownerId])
  @@index([ownerType])
}
